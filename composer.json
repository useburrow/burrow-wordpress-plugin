{
  "name": "useburrow/burrow-wordpress-plugin",
  "description": "Burrow WordPress plugin integration with durable outbox.",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../burrow-sdk/php",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "useburrow/sdk-php": "^0.9.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "psr-4": {
      "BurrowWP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}
